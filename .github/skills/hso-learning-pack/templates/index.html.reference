<!-- ───────────── Hero ───────────── -->
<header class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">HSO portfolio · insurance brokerage finance</div>
    <h1>ERP <strong>Unite</strong></h1>
    <p class="hero-tagline">A finance platform purpose-built for insurance brokerages — now in HSO's portfolio. Statements, cash, commissions, journals, accruals, and producer compensation in one connected workflow.</p>

