<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ERP Unite — HSO Learning Pack</title>
<style>
  /* ─────────────────────────────────────────────────────────────────
     HSO brand palette
     Navy   #00395F  primary
     Cyan   #079FC3  accent
     Teal   #00B294  success
     Red    #F1554B  highlight
     Yellow #F2B949  highlight
     Slate  #44546A  secondary text
     ───────────────────────────────────────────────────────────────── */

  :root {
    --navy: #00395F;
    --navy-dark: #00253D;
    --navy-light: #1A5A8A;
    --cyan: #079FC3;
    --cyan-light: #4AB9D4;
    --teal: #00B294;
    --red: #F1554B;
    --yellow: #F2B949;
    --slate: #44546A;
    --mute: #737373;
    --bg: #FAFBFC;
    --card-bg: #FFFFFF;
    --border: #E5E9EE;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--navy);
    background: var(--bg);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }



  /* ─── Insurance Brokerage Primer section ─── */
  .primer-section {
    background: linear-gradient(135deg, #FFFAEC 0%, #FFF4DA 50%, #FFE9C4 100%);
    padding: 72px 40px;
    max-width: none;
    margin: 0;
    border-top: 1px solid rgba(242, 185, 73, 0.4);
    border-bottom: 1px solid rgba(242, 185, 73, 0.4);
    position: relative;
  }
  .primer-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--yellow) 0%, var(--red) 100%);
  }
  .primer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .primer-content h2 {
    font-size: 48px;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 18px;
  }
  .primer-eyebrow {
    color: var(--navy) !important;
    font-weight: 800;
  }
  .primer-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .primer-btn {
    padding: 12px 24px !important;
    font-size: 15px !important;
  }
  .primer-meta {
    font-size: 13px;
    color: var(--slate);
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .primer-meta strong { color: var(--navy); }
  .primer-dot { color: var(--mute); }
  .primer-pullquotes {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .primer-quote {
    background: white;
    border-left: 4px solid var(--yellow);
    border-radius: 0 8px 8px 0;
    padding: 18px 22px;
    margin: 0;
    box-shadow: 0 6px 18px rgba(165, 116, 30, 0.10);
  }
  .primer-quote:nth-child(2) { border-left-color: var(--red); }
  .primer-quote:nth-child(3) { border-left-color: var(--cyan); }
  .primer-quote p {
    font-size: 16px;
    color: var(--navy);
    font-style: italic;
    line-height: 1.55;
    margin: 0 0 8px 0;
  }
  .primer-quote cite {
    font-size: 12px;
    color: var(--mute);
    font-style: normal;
    letter-spacing: 0.3px;
  }
  @media (max-width: 920px) {
    .primer-inner { grid-template-columns: 1fr; gap: 32px; }
    .primer-content h2 { font-size: 36px; }
  }

  /* ─── Start-here carousel ─── */
  .primer-carousel {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }
  .primer-stage-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .primer-stage-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--navy);
  }
  .primer-stage-pos {
    background: rgba(0, 57, 95, 0.10);
    color: var(--navy);
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.8px;
  }
  .primer-stage-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .primer-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .primer-dot-btn {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--navy);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .primer-dot-btn[aria-current="true"] {
    background: var(--navy);
    transform: scale(1.1);
  }
  .primer-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid var(--navy);
    background: white;
    color: var(--navy);
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .primer-arrow:hover {
    background: var(--navy);
    color: white;
    transform: scale(1.05);
  }
  .primer-arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }
  .primer-stages-viewport {
    overflow: hidden;
    border-radius: 12px;
  }
  .primer-stages-track {
    display: flex;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  .primer-stage {
    flex: 0 0 100%;
    min-width: 0;
  }
  .primer-stage .primer-inner {
    margin: 0 auto;
    padding: 4px 2px;
  }
  /* Stage 2 + 3 right column: module mini-cards */
  .module-mini-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .module-mini {
    background: white;
    border-radius: 10px;
    padding: 14px 16px;
    box-shadow: 0 4px 14px rgba(165, 116, 30, 0.10);
    border-top: 3px solid var(--yellow);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .module-mini:nth-child(3n+2) { border-top-color: var(--red); }
  .module-mini:nth-child(3n+3) { border-top-color: var(--cyan); }
  .module-mini h4 {
    font-size: 14px;
    font-weight: 700;
    color: var(--navy);
    margin: 0;
    line-height: 1.25;
  }
  .module-mini p {
    font-size: 12.5px;
    color: var(--slate);
    margin: 0;
    line-height: 1.45;
  }
  .module-mini-links {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }
  .module-mini-links a {
    flex: 1;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .module-mini-links .mm-view {
    background: rgba(0, 57, 95, 0.08);
    color: var(--navy);
  }
  .module-mini-links .mm-view:hover { background: var(--navy); color: white; }
  .module-mini-links .mm-watch {
    background: rgba(7, 159, 195, 0.10);
    color: var(--cyan);
  }
  .module-mini-links .mm-watch:hover { background: var(--cyan); color: white; }
  @media (max-width: 720px) {
    .module-mini-grid { grid-template-columns: 1fr; }
  }

  /* ─── Top-right quick menu ─── */
  .topnav {
    position: fixed;
    top: 0; right: 0;
    z-index: 1000;
    padding: 14px 28px;
    display: flex;
    gap: 6px;
    align-items: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: rgba(0, 37, 61, 0.72);
    border-bottom-left-radius: 12px;
    box-shadow: 0 4px 18px rgba(0, 37, 61, 0.18);
  }
  .topnav a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 6px 12px;
    border-radius: 6px;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .topnav a:hover { background: rgba(7, 159, 195, 0.18); color: #4AB9D4; }
  .topnav a.topnav-cta {
    background: var(--cyan);
    color: white;
    margin-left: 6px;
    padding: 6px 14px;
  }
  .topnav a.topnav-cta:hover { background: white; color: var(--navy); }
  .topnav .topnav-star { color: var(--yellow); margin-right: 2px; }
  @media (max-width: 720px) {
    .topnav { padding: 10px 16px; gap: 2px; }
    .topnav a { padding: 5px 8px; font-size: 12px; }
    .topnav a.topnav-cta { padding: 5px 10px; }
    /* Drop labels on tightest screens, keep CTA */
    .topnav .topnav-collapse { display: none; }
  }

  /* ─── Hero ─── */

  .hero {
    background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 50%, var(--navy-light) 100%);
    color: white;
    padding: 80px 40px 100px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(7, 159, 195, 0.25) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--cyan) 0%, var(--teal) 50%, var(--cyan) 100%);
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .hero-eyebrow {
    color: var(--cyan-light);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .hero h1 {
    font-size: 72px;
    font-weight: 300;
    letter-spacing: -1.5px;
    line-height: 1.05;
    margin-bottom: 24px;
  }

  .hero h1 strong { font-weight: 600; color: var(--cyan-light); }

  .hero-tagline {
    font-size: 22px;
    font-weight: 300;
    max-width: 720px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 40px;
  }

  .hero-stats {
    display: flex;
    gap: 48px;
    margin-top: 48px;
    flex-wrap: wrap;
  }

  .hero-stat {
    border-left: 3px solid var(--cyan);
    padding-left: 16px;
  }

  .hero-stat-num {
    font-size: 36px;
    font-weight: 600;
    color: white;
    line-height: 1;
  }

  .hero-stat-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 6px;
    letter-spacing: 0.5px;
  }

  /* ─── Section frame ─── */

  section {
    padding: 80px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-eyebrow {
    color: var(--cyan);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  h2 {
    font-size: 42px;
    font-weight: 400;
    letter-spacing: -0.5px;
    line-height: 1.15;
    margin-bottom: 16px;
    color: var(--navy);
  }

  h2 .accent { color: var(--cyan); font-weight: 600; }

  .section-lede {
    font-size: 18px;
    color: var(--slate);
    max-width: 720px;
    margin-bottom: 48px;
  }

  /* ─── Audience cards ─── */

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--cyan);
  }

  .card.executive::before { background: var(--navy); }
  .card.sales::before     { background: var(--red); }
  .card.functional::before{ background: var(--teal); }
  .card.technical::before { background: var(--cyan); }
  .card.ea::before        { background: var(--yellow); }
  .card.pm::before        { background: linear-gradient(90deg, var(--teal) 0%, var(--cyan) 100%); }
  .card.industry::before  { background: linear-gradient(90deg, var(--yellow) 0%, var(--red) 100%); }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 57, 95, 0.12);
    border-color: var(--cyan);
  }

  .card-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 700;
    color: white;
    margin-bottom: 20px;
  }

  .card.executive .card-icon { background: var(--navy); }
  .card.sales .card-icon     { background: var(--red); }
  .card.functional .card-icon{ background: var(--teal); }
  .card.technical .card-icon { background: var(--cyan); }
  .card.ea .card-icon        { background: var(--yellow); color: var(--navy); }
  .card.pm .card-icon        { background: linear-gradient(135deg, var(--teal) 0%, var(--cyan) 100%); }
  .card.industry .card-icon  { background: linear-gradient(135deg, var(--yellow) 0%, var(--red) 100%); color: white; }

  .card h3 {
    font-size: 24px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .card-role {
    font-size: 13px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .card-desc {
    color: var(--slate);
    font-size: 15px;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .card-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    font-size: 13px;
    color: var(--mute);
  }

  .card-meta strong { color: var(--navy); font-weight: 600; }

  .card-links {
    display: flex;
    gap: 6px;
  }

  .card-links .btn {
    flex: 1;
    justify-content: center;
    padding: 8px 10px;
    text-align: center;
    white-space: nowrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .btn-primary {
    background: var(--navy);
    color: white;
  }

  .btn-primary:hover { background: var(--cyan); }

  .btn-secondary {
    background: transparent;
    color: var(--navy);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: var(--cyan);
    color: white;
    border-color: var(--cyan);
  }

  .btn-watch {
    background: var(--teal);
    color: white;
    border: 1px solid var(--teal);
  }

  .btn-watch:hover {
    background: var(--navy);
    border-color: var(--navy);
  }

  /* ─── Architecture block ─── */

  .architecture {
    background: linear-gradient(180deg, #FAFBFC 0%, #F0F4F8 100%);
    border-radius: 16px;
    padding: 48px;
    margin: 0 auto;
  }

  .arch-diagram {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    overflow-x: auto;
  }

  .arch-svg-wrap { width: 100%; overflow-x: auto; }

  /* ─── Gallery ─── */

  .gallery {
    background: linear-gradient(180deg, var(--bg) 0%, #F0F4F8 100%);
    padding: 80px 0;
    margin: 0;
    max-width: none;
  }

  .gallery-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .gallery-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 32px;
    background: white;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--border);
    width: fit-content;
  }

  .gallery-tab {
    padding: 10px 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--slate);
    cursor: pointer;
    border: none;
    background: transparent;
    transition: background 0.15s ease, color 0.15s ease;
    font-family: inherit;
  }

  .gallery-tab.active {
    background: var(--navy);
    color: white;
  }

  .gallery-tab:not(.active):hover {
    background: var(--bg);
    color: var(--navy);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  .gallery-grid.hero {
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    margin-bottom: 24px;
  }

  .gallery-item {
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    display: block;
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 57, 95, 0.18);
    border-color: var(--cyan);
  }

  .gallery-thumb {
    aspect-ratio: 16 / 9;
    background: #F4F7FA;
    overflow: hidden;
    display: block;
    position: relative;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery-item:hover .gallery-thumb img {
    transform: scale(1.04);
  }

  .gallery-caption {
    padding: 14px 18px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .gallery-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.3;
  }

  .gallery-pill {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .gallery-pill.cashhub { background: rgba(0, 57, 95, 0.1); color: var(--navy); }
  .gallery-pill.comphub { background: rgba(7, 159, 195, 0.15); color: var(--cyan); }

  .gallery-section-label {
    grid-column: 1 / -1;
    font-size: 13px;
    font-weight: 700;
    color: var(--cyan);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 24px;
    margin-bottom: 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .gallery-note {
    background: rgba(242, 185, 73, 0.12);
    border-left: 4px solid var(--yellow);
    padding: 14px 20px;
    border-radius: 0 8px 8px 0;
    font-size: 14px;
    color: var(--slate);
    margin-top: 32px;
  }

  .gallery-note strong { color: var(--navy); }

  /* ─── Quick launch ─── */

  .quick-launch {
    background: var(--navy);
    color: white;
    padding: 60px 40px;
    margin: 0;
    max-width: none;
    position: relative;
    overflow: hidden;
  }

  .quick-launch::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--cyan);
  }

  .quick-launch-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .quick-launch h2 { color: white; }

  .quick-launch .section-lede { color: rgba(255, 255, 255, 0.75); }

  .launch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .launch-tile {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(7, 159, 195, 0.3);
    border-radius: 10px;
    padding: 20px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .launch-tile:hover {
    background: rgba(7, 159, 195, 0.15);
    border-color: var(--cyan);
  }

  .launch-tile h4 {
    color: var(--cyan-light);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .launch-tile code {
    display: block;
    color: rgba(255, 255, 255, 0.9);
    font-family: 'Cascadia Code', 'Consolas', monospace;
    font-size: 13px;
    margin-top: 8px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    overflow-x: auto;
    white-space: nowrap;
  }

  .launch-tile p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14px;
    margin-bottom: 8px;
  }

  /* ─── Footer ─── */

  footer {
    background: var(--navy-dark);
    color: rgba(255, 255, 255, 0.7);
    padding: 32px 40px;
    text-align: center;
    font-size: 13px;
  }

  footer strong { color: var(--cyan-light); }

  /* ─── Pillars row ─── */

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }

  .pillar {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
    text-align: left;
    border-top: 4px solid var(--cyan);
  }

  .pillar:nth-child(2) { border-top-color: var(--teal); }
  .pillar:nth-child(3) { border-top-color: var(--red); }
  .pillar:nth-child(4) { border-top-color: var(--yellow); }

  .pillar {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .pillar:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 57, 95, 0.14);
    border-color: var(--cyan);
  }

  .pillar h4 {
    color: var(--navy);
    font-size: 18px;
    margin-bottom: 8px;
  }

  .pillar p {
    color: var(--slate);
    font-size: 14px;
    line-height: 1.55;
  }

  .pillar-link-cue {
    margin-top: 10px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--cyan);
    opacity: 0.8;
  }

  .pillar:hover .pillar-link-cue { opacity: 1; }

  .pillar-num {
    font-size: 28px;
    font-weight: 700;
    color: var(--cyan);
    line-height: 1;
    margin-bottom: 12px;
  }

  .pillar:nth-child(2) .pillar-num { color: var(--teal); }
  .pillar:nth-child(3) .pillar-num { color: var(--red); }
  .pillar:nth-child(4) .pillar-num { color: var(--yellow); }

  /* ─── Responsive ─── */

  @media (max-width: 720px) {
    .hero h1 { font-size: 48px; }
    .hero-tagline { font-size: 18px; }
    section { padding: 56px 24px; }
    h2 { font-size: 32px; }
    .architecture { padding: 28px 20px; }
  }
</style>
</head>
<body>

