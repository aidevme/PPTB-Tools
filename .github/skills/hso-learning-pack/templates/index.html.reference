<!-- ───────────── Video modal ───────────── -->
<dialog id="video-modal" aria-label="Narrated deck player">
  <div class="video-frame">
    <button class="video-action video-close" type="button" aria-label="Close video" title="Close (Esc)">×</button>
    <button class="video-action video-max"   type="button" aria-label="Toggle theatre"  title="Theatre / restore">⛶</button>
    <video class="video-player" controls preload="metadata" playsinline></video>
    <div class="video-title"></div>
  </div>
</dialog>

<style>
  #video-modal {
    background: transparent;
    border: none;
    padding: 0;
    /* Center the dialog both axes. `inset: 0 + margin: auto` is the modern
       cross-browser way; height: max-content keeps the box content-sized so
       the margin algorithm can split remaining viewport space evenly. */
    position: fixed;
    inset: 0;
    margin: auto;
    width: max-content;
    height: max-content;
    max-width: 100vw;
    max-height: 100vh;
    overflow: visible;
    color: white;
  }
  #video-modal::backdrop {
    background: rgba(0, 37, 61, 0.82);
    backdrop-filter: blur(6px);
  }
  #video-modal .video-frame {
    position: relative;
    background: #000;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.65);
    width: clamp(320px, 90vw, 1600px);
    /* Resizable from the bottom-right corner */
    resize: both;
    overflow: hidden;
    min-width: 320px;
    min-height: 240px;
    max-width: 96vw;
    max-height: 92vh;
  }
  #video-modal.maximized .video-frame {
    width: 96vw !important;
    height: 92vh !important;
    max-width: 96vw;
    max-height: 92vh;
    resize: none;
    border-radius: 8px;
  }
  #video-modal .video-player {
    display: block;
    width: 100%;
    height: calc(100% - 48px);
    background: #000;
  }
  #video-modal .video-title {
    height: 48px;
    padding: 12px 22px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
    border-top: 1px solid rgba(255,255,255,0.1);
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,37,61,0.6) 100%);
    box-sizing: border-box;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #video-modal .video-action {
    position: absolute;
    top: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 37, 61, 0.7);
    backdrop-filter: blur(4px);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
    transition: background 0.15s ease, transform 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #video-modal .video-close { right: 12px; font-size: 22px; }
  #video-modal .video-max   { right: 56px; }
  #video-modal .video-action:hover {
    background: var(--cyan);
    transform: scale(1.08);
  }
  /* Tiny visual cue that the bottom-right is a resize handle */
  #video-modal:not(.maximized) .video-frame::after {
    content: '';
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 14px;
    height: 14px;
    background:
      linear-gradient(135deg, transparent 0 6px, rgba(255,255,255,0.35) 6px 8px, transparent 8px 10px, rgba(255,255,255,0.35) 10px 12px, transparent 12px);
    pointer-events: none;
  }
</style>

<script>
  (function() {
    const modal  = document.getElementById('video-modal');
    if (!modal) return;
    const frame  = modal.querySelector('.video-frame');
    const video  = modal.querySelector('.video-player');
    const title  = modal.querySelector('.video-title');
    const close  = modal.querySelector('.video-close');
    const max    = modal.querySelector('.video-max');

    function openVideo(src, label) {
      video.src = src;
      title.textContent = label || '';
      modal.showModal();
      video.play().catch(() => {});
    }
    function closeVideo() {
      video.pause();
      video.removeAttribute('src');
      video.load();
      modal.classList.remove('maximized');
      if (modal.open) modal.close();
    }
    function toggleMax() {
      modal.classList.toggle('maximized');
      max.textContent = modal.classList.contains('maximized') ? '⛶' : '⛶';
      max.title = modal.classList.contains('maximized') ? 'Restore' : 'Theatre';
    }

    // Intercept .btn-watch clicks. Right-click / Ctrl+click / middle-click
    // still opens the MP4 in a new tab via the native href.
    document.querySelectorAll('a.btn-watch, a.deck-btn-watch, a.feat-card-deck-watch, a.mm-watch').forEach(a => {
      a.addEventListener('click', e => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        const card = a.closest('.feat-card-wrap, .card, .hub-hero, .section');
        const label = card ? (card.querySelector('h1, h2, h3')?.textContent || '') : '';
        openVideo(a.getAttribute('href'), label.trim());
      });
    });

    close.addEventListener('click', closeVideo);
    max.addEventListener('click', toggleMax);
    // Click outside the video frame closes
    modal.addEventListener('click', e => {
      if (!frame.contains(e.target)) closeVideo();
    });
    // ESC — dialog handles it natively, we just clean up
    modal.addEventListener('close', () => {
      video.pause();
      video.removeAttribute('src');
      video.load();
      modal.classList.remove('maximized');
    });
    // 'f' toggles theatre mode while modal is open
    document.addEventListener('keydown', e => {
      if (modal.open && (e.key === 'f' || e.key === 'F') && !e.target.matches('input, textarea')) {
        toggleMax();
      }
    });
  })();

  // ─── Start-here carousel ───
  (function () {
    const carousel = document.getElementById('primer-carousel');
    if (!carousel) return;
    const track   = document.getElementById('primer-track');
    const stages  = track.querySelectorAll('.primer-stage');
    const dots    = carousel.querySelectorAll('.primer-dot-btn');
    const prevBtn = document.getElementById('primer-prev');
    const nextBtn = document.getElementById('primer-next');
    const posEl   = document.getElementById('primer-pos');
    const titleEl = document.getElementById('primer-stage-title');
    const total   = stages.length;
    let current = 0;

    function update(idx) {
      current = Math.max(0, Math.min(total - 1, idx));
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach((d, i) => {
        if (i === current) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === total - 1;
      posEl.textContent = (current + 1) + ' of ' + total;
      titleEl.textContent = stages[current].getAttribute('data-stage-title') || '';
    }

    prevBtn.addEventListener('click', () => update(current - 1));
    nextBtn.addEventListener('click', () => update(current + 1));
    dots.forEach(d => d.addEventListener('click', () => update(parseInt(d.dataset.stage, 10))));

    // Keyboard nav when the carousel region has focus
    carousel.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft')  { e.preventDefault(); update(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); update(current + 1); }
    });

    update(0);
  })();
</script>

</body>
</html>
