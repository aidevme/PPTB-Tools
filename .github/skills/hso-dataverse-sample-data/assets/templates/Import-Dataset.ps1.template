<#
.SYNOPSIS
Imports the __DATASET__ sample dataset into a Dataverse environment (idempotent, GUID-preserving).

.DESCRIPTION
Generic manifest-driven upsert engine. Reads manifest.psd1, then for each table (in
dependency order) reads its numbered CSV and upserts every row BY PRIMARY-KEY GUID:
  - record absent  -> POST (create with the CSV's GUID preserved)
  - record present -> PATCH only the changed fields (blank CSV value = leave-alone)
Re-running converges to the same end state - no duplicates, no churn.

Add any scenario-specific post-seed steps (status transitions, action invocations,
flow drains) in the marked region near the bottom; the generic engine handles the rows.

.PARAMETER EnvironmentUrl   Target environment. Production URLs are blocked.
.PARAMETER DryRun           Validate + report only; perform no writes.
.PARAMETER BatchSize        Reserved for bulk paths (default 100).

.EXAMPLE
.\Import-__DATASET__.ps1 -EnvironmentUrl https://yourorg.crm.dynamics.com/ -Interactive

.NOTES
Authority SOP: shared/dv/agent/wiki/sop/sample-data/sample-data-validation-workflow.md
Scaffolded by the hso-dataverse-sample-data skill. Do not add client data to this file.
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)][string]$EnvironmentUrl,
    [switch]$Interactive,
    [string]$AccessToken,
    [string]$ClientId,
    [string]$ClientSecret,
    [switch]$DryRun,
    [int]$BatchSize = 100,
    [string]$AuthSettingsPath = (Join-Path $PSScriptRoot '..\..\..\.claude\auth-settings.json')
)

$ErrorActionPreference = 'Stop'

# Dot-source the repo-root shared module without it clobbering our bound params.
$_saved = @{ E = $EnvironmentUrl; A = $AccessToken; I = $Interactive; C = $ClientId; S = $ClientSecret; P = $AuthSettingsPath; D = $DryRun; B = $BatchSize }
$commonFunctions = Join-Path $PSScriptRoot '..\..\..\.scripts\Common-Functions.ps1'
if (-not (Test-Path $commonFunctions)) { throw "Common-Functions.ps1 not found at $commonFunctions. Run hso-dataverse-init-repo to provision it." }
. $commonFunctions
$EnvironmentUrl = $_saved.E; $AccessToken = $_saved.A; $Interactive = $_saved.I; $ClientId = $_saved.C; $ClientSecret = $_saved.S; $AuthSettingsPath = $_saved.P; $DryRun = $_saved.D; $BatchSize = $_saved.B

# --- Production guard -----------------------------------------------------
$blocklistFile = Join-Path $PSScriptRoot '..\..\..\.scripts\ProductionEnvironments.txt'
$ProductionUrls = @('prod.crm.dynamics.com', 'production.crm.dynamics.com')
if (Test-Path $blocklistFile) { $ProductionUrls += (Get-Content $blocklistFile | Where-Object { $_ -and -not $_.StartsWith('#') }) }
$normalizedEnvUrl = $EnvironmentUrl.TrimEnd('/')
$lc = $normalizedEnvUrl.ToLower()
foreach ($blocked in $ProductionUrls) { if ($lc -like "*$($blocked.Trim().ToLower())*") { Write-Error "BLOCKED: '$EnvironmentUrl' matches a production pattern. Sample data must never reach production."; exit 1 } }

# --- Auth (token -> interactive -> service principal) ---------------------
$script:EnvironmentUrl = $normalizedEnvUrl
if ($AccessToken) {
    $script:AuthToken = $AccessToken; $script:TokenExpiry = (Get-Date).AddHours(1)
    Write-Host "[AUTH] Using pre-obtained access token" -ForegroundColor Cyan
}
elseif ($Interactive) {
    $script:AuthToken = Get-DataverseTokenInteractive -EnvironmentUrl $normalizedEnvUrl
    if (-not $script:AuthToken) { Write-Error "Interactive authentication failed."; exit 1 }
}
else {
    if ((-not $ClientId -or -not $ClientSecret) -and (Test-Path $AuthSettingsPath)) {
        $a = Get-Content $AuthSettingsPath -Raw | ConvertFrom-Json
        $ClientId = $a.DataverseClientId; $ClientSecret = $a.DataverseClientSecret; $tenantId = $a.DataverseTenantId
    }
    if (-not $ClientId -or -not $ClientSecret) { Write-Error "No credentials. Provide -AccessToken / -Interactive / -ClientId+-ClientSecret, or a .claude/auth-settings.json."; exit 1 }
    if ($tenantId) {
        $resp = Invoke-RestMethod -Uri "https://login.microsoftonline.com/$tenantId/oauth2/token" -Method Post -ContentType 'application/x-www-form-urlencoded' -Body @{ grant_type = 'client_credentials'; client_id = $ClientId; client_secret = $ClientSecret; resource = $normalizedEnvUrl }
        $script:AuthToken = $resp.access_token; $script:TokenExpiry = (Get-Date).AddSeconds([int]$resp.expires_in - 300)
    } else {
        $script:AuthToken = Get-DataverseToken -EnvironmentUrl $normalizedEnvUrl -ClientId $ClientId -ClientSecret $ClientSecret
    }
    if (-not $script:AuthToken) { Write-Error "Authentication failed."; exit 1 }
    Write-Host "[AUTH] Authenticated via service principal" -ForegroundColor Green
}
$script:EnvironmentUrl = $normalizedEnvUrl

# --- Thin Web API helpers -------------------------------------------------
function DvHeaders { @{ Authorization = "Bearer $($script:AuthToken)"; 'OData-MaxVersion' = '4.0'; 'OData-Version' = '4.0'; Accept = 'application/json'; 'Content-Type' = 'application/json; charset=utf-8' } }
function DvGet([string]$ep) { Invoke-RestMethod -Uri "$($script:EnvironmentUrl)/api/data/v9.2/$ep" -Method Get -Headers (DvHeaders) }
function DvExists([string]$ep) { try { DvGet $ep | Out-Null; return $true } catch { return $false } }
function DvPost([string]$set, [hashtable]$body) { Invoke-RestMethod -Uri "$($script:EnvironmentUrl)/api/data/v9.2/$set" -Method Post -Headers (DvHeaders) -Body ([System.Text.Encoding]::UTF8.GetBytes(($body | ConvertTo-Json -Depth 10))) }
function DvPatch([string]$set, [string]$id, [hashtable]$body) { $h = DvHeaders; $h['If-Match'] = '*'; Invoke-RestMethod -Uri "$($script:EnvironmentUrl)/api/data/v9.2/$set($id)" -Method Patch -Headers $h -Body ([System.Text.Encoding]::UTF8.GetBytes(($body | ConvertTo-Json -Depth 10))) }

function Convert-CsvValue($raw, [string]$type) {
    switch ($type) {
        'int'     { return [int]$raw }
        'decimal' { return [double]$raw }
        'money'   { return [double]$raw }
        'bool'    { return [System.Convert]::ToBoolean($raw) }
        'date'    { return ([datetime]::Parse($raw)).ToString('yyyy-MM-dd') }
        default   { return "$raw" }
    }
}

# Build the Web API payload for one CSV row from the table's manifest entry.
function Build-Payload($row, $table) {
    $payload = @{}
    $lookupCols = @{}   # CSV column name -> binding spec
    foreach ($lk in $table.Lookups.GetEnumerator()) {
        $lookupCols["_$($lk.Value.FieldName)_value"] = $lk.Value
        $lookupCols[$lk.Value.FieldName] = $lk.Value
    }
    foreach ($prop in $row.PSObject.Properties) {
        $col = $prop.Name; $val = $prop.Value
        if ($col -eq $table.PrimaryKey) { continue }                       # PK handled separately
        if ([string]::IsNullOrWhiteSpace([string]$val)) { continue }       # blank = leave-alone
        if ($lookupCols.ContainsKey($col)) {
            $spec = $lookupCols[$col]
            $payload["$($spec.FieldName)@odata.bind"] = "/$($spec.EntitySet)($val)"
            continue
        }
        $type = if ($table.FieldTypes -and $table.FieldTypes.ContainsKey($col)) { $table.FieldTypes[$col] } else { 'string' }
        if ($type -eq 'lookup') { continue }   # lookup declared via FieldTypes but not Lookups - skip, needs a binding
        $payload[$col] = Convert-CsvValue $val $type
    }
    return $payload
}

# --- Load manifest + iterate tables --------------------------------------
$DatasetPath = $PSScriptRoot
$manifest = Import-PowerShellDataFile (Join-Path $DatasetPath 'manifest.psd1')
$created = 0; $updated = 0; $skipped = 0; $failed = 0
if ($DryRun) { Write-Host "[DRY-RUN] No writes will occur." -ForegroundColor Yellow }

foreach ($table in $manifest.Tables) {
    Write-Host "`n========== $($table.TableName) ($($table.FileName)) ==========" -ForegroundColor Cyan
    $csvPath = Join-Path $DatasetPath $table.FileName
    if (-not (Test-Path $csvPath)) { Write-Warning "  CSV not found: $($table.FileName) - skipping"; continue }
    $rows = Import-Csv -Path $csvPath -Encoding UTF8
    foreach ($row in $rows) {
        $id = $row.($table.PrimaryKey)
        $label = if ($table.NameField -and $row.PSObject.Properties[$table.NameField]) { $row.($table.NameField) } else { $id }
        if ([string]::IsNullOrWhiteSpace($id)) { Write-Warning "  ROW missing primary key - skipped"; $failed++; continue }
        $payload = Build-Payload $row $table
        $exists = DvExists "$($table.EntitySet)($id)?`$select=$($table.PrimaryKey)"
        try {
            if ($exists) {
                if ($DryRun) { Write-Host "  WOULD PATCH: $label" -ForegroundColor DarkGray; $updated++; continue }
                DvPatch $table.EntitySet $id $payload | Out-Null
                Write-Host "  UPDATED: $label" -ForegroundColor Green; $updated++
            } else {
                $payload[$table.PrimaryKey] = $id     # preserve the GUID on create
                if ($DryRun) { Write-Host "  WOULD CREATE: $label" -ForegroundColor DarkGray; $created++; continue }
                DvPost $table.EntitySet $payload | Out-Null
                Write-Host "  CREATED: $label" -ForegroundColor Green; $created++
            }
        } catch {
            Write-Warning "  FAILED: $label - $_"; $failed++
        }
    }
}

# =========================================================================
# SCENARIO-SPECIFIC POST-SEED STEPS (optional)
# Add status transitions (SetState), Custom API / action invocations, flow
# drains, or read-back assertions here. Keep each step idempotent (guard with
# an existence/status check) so the whole script stays safe to re-run.
# =========================================================================


# --- Summary --------------------------------------------------------------
Write-Host "`n========== Import Summary ($([System.IO.Path]::GetFileName($DatasetPath))) ==========" -ForegroundColor $(if ($failed -eq 0) { 'Green' } else { 'Yellow' })
Write-Host "  Created : $created"  -ForegroundColor White
Write-Host "  Updated : $updated"  -ForegroundColor White
Write-Host "  Skipped : $skipped"  -ForegroundColor White
Write-Host "  Failed  : $failed"   -ForegroundColor $(if ($failed -gt 0) { 'Red' } else { 'White' })
if ($DryRun) { Write-Host "  [DRY-RUN] No writes performed." -ForegroundColor Yellow }
if ($failed -gt 0) { exit 1 }
