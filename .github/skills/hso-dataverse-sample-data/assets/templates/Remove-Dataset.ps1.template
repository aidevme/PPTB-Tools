<#
.SYNOPSIS
Removes the __DATASET__ seeded records from a Dataverse environment.

.DESCRIPTION
The inverse of Import. Iterates the manifest's tables in REVERSE order (children
before parents) and deletes every row whose primary-key GUID appears in the CSVs.
Records already gone are logged [SKIP] and skipped - so Remove is safe to re-run.
Matching by GUID guarantees the script only deletes records THIS dataset owns.

.PARAMETER EnvironmentUrl   Target environment. Production URLs are blocked.

.EXAMPLE
.\Remove-__DATASET__.ps1 -EnvironmentUrl https://yourorg.crm.dynamics.com/ -Interactive

.NOTES
Authority SOP: shared/dv/agent/wiki/sop/sample-data/sample-data-validation-workflow.md
Scaffolded by the hso-dataverse-sample-data skill. Do not add client data to this file.
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)][string]$EnvironmentUrl,
    [switch]$Interactive,
    [string]$AccessToken,
    [string]$ClientId,
    [string]$ClientSecret,
    [string]$AuthSettingsPath = (Join-Path $PSScriptRoot '..\..\..\.claude\auth-settings.json')
)

$ErrorActionPreference = 'Stop'
$_saved = @{ E = $EnvironmentUrl; A = $AccessToken; I = $Interactive; C = $ClientId; S = $ClientSecret; P = $AuthSettingsPath }
$commonFunctions = Join-Path $PSScriptRoot '..\..\..\.scripts\Common-Functions.ps1'
if (-not (Test-Path $commonFunctions)) { throw "Common-Functions.ps1 not found at $commonFunctions. Run hso-dataverse-init-repo to provision it." }
. $commonFunctions
$EnvironmentUrl = $_saved.E; $AccessToken = $_saved.A; $Interactive = $_saved.I; $ClientId = $_saved.C; $ClientSecret = $_saved.S; $AuthSettingsPath = $_saved.P

$blocklistFile = Join-Path $PSScriptRoot '..\..\..\.scripts\ProductionEnvironments.txt'
$ProductionUrls = @('prod.crm.dynamics.com', 'production.crm.dynamics.com')
if (Test-Path $blocklistFile) { $ProductionUrls += (Get-Content $blocklistFile | Where-Object { $_ -and -not $_.StartsWith('#') }) }
$normalizedEnvUrl = $EnvironmentUrl.TrimEnd('/')
$lc = $normalizedEnvUrl.ToLower()
foreach ($blocked in $ProductionUrls) { if ($lc -like "*$($blocked.Trim().ToLower())*") { Write-Error "BLOCKED: '$EnvironmentUrl' matches a production pattern."; exit 1 } }

$script:EnvironmentUrl = $normalizedEnvUrl
if ($AccessToken) { $script:AuthToken = $AccessToken; $script:TokenExpiry = (Get-Date).AddHours(1) }
elseif ($Interactive) { $script:AuthToken = Get-DataverseTokenInteractive -EnvironmentUrl $normalizedEnvUrl }
else {
    if ((-not $ClientId -or -not $ClientSecret) -and (Test-Path $AuthSettingsPath)) {
        $a = Get-Content $AuthSettingsPath -Raw | ConvertFrom-Json
        $ClientId = $a.DataverseClientId; $ClientSecret = $a.DataverseClientSecret; $tenantId = $a.DataverseTenantId
    }
    if ($tenantId) {
        $resp = Invoke-RestMethod -Uri "https://login.microsoftonline.com/$tenantId/oauth2/token" -Method Post -ContentType 'application/x-www-form-urlencoded' -Body @{ grant_type = 'client_credentials'; client_id = $ClientId; client_secret = $ClientSecret; resource = $normalizedEnvUrl }
        $script:AuthToken = $resp.access_token
    } else { $script:AuthToken = Get-DataverseToken -EnvironmentUrl $normalizedEnvUrl -ClientId $ClientId -ClientSecret $ClientSecret }
}
if (-not $script:AuthToken) { Write-Error "Authentication failed."; exit 1 }
$script:EnvironmentUrl = $normalizedEnvUrl

function DvHeaders { @{ Authorization = "Bearer $($script:AuthToken)"; 'OData-MaxVersion' = '4.0'; 'OData-Version' = '4.0'; Accept = 'application/json' } }
function DvGet([string]$ep) { Invoke-RestMethod -Uri "$($script:EnvironmentUrl)/api/data/v9.2/$ep" -Method Get -Headers (DvHeaders) }
function DvExists([string]$ep) { try { DvGet $ep | Out-Null; return $true } catch { return $false } }
function DvDelete([string]$ep) { Invoke-RestMethod -Uri "$($script:EnvironmentUrl)/api/data/v9.2/$ep" -Method Delete -Headers (DvHeaders) }

$DatasetPath = $PSScriptRoot
$manifest = Import-PowerShellDataFile (Join-Path $DatasetPath 'manifest.psd1')
$deleted = 0; $skipped = 0; $failed = 0

# Children before parents.
$tablesReverse = @($manifest.Tables); [array]::Reverse($tablesReverse)
foreach ($table in $tablesReverse) {
    Write-Host "`n========== Remove $($table.TableName) ==========" -ForegroundColor Cyan
    $csvPath = Join-Path $DatasetPath $table.FileName
    if (-not (Test-Path $csvPath)) { Write-Warning "  CSV not found: $($table.FileName) - skipping"; continue }
    foreach ($row in (Import-Csv -Path $csvPath -Encoding UTF8)) {
        $id = $row.($table.PrimaryKey)
        $label = if ($table.NameField -and $row.PSObject.Properties[$table.NameField]) { $row.($table.NameField) } else { $id }
        if ([string]::IsNullOrWhiteSpace($id)) { continue }
        if (-not (DvExists "$($table.EntitySet)($id)?`$select=$($table.PrimaryKey)")) {
            Write-Host "  SKIP (not found): $label" -ForegroundColor Gray; $skipped++; continue
        }
        try { DvDelete "$($table.EntitySet)($id)" | Out-Null; Write-Host "  DELETED: $label" -ForegroundColor Green; $deleted++ }
        catch { Write-Warning "  FAILED: $label - $_"; $failed++ }
    }
}

Write-Host "`n========== Remove Summary ==========" -ForegroundColor $(if ($failed -eq 0) { 'Green' } else { 'Yellow' })
Write-Host "  Deleted : $deleted" -ForegroundColor White
Write-Host "  Skipped : $skipped" -ForegroundColor White
Write-Host "  Failed  : $failed"  -ForegroundColor $(if ($failed -gt 0) { 'Red' } else { 'White' })
if ($failed -gt 0) { exit 1 }
