# Solution Map (TOPO — Topology of Platform Objects)
# Seed this into agent/wiki/system/solution-map.topo at project init (SOP-1), then maintain it as a
# mandatory sub-step of every build skill. This is the BLANK template — replace the examples.

meta:
  project: {projectCode}
  platform_profile: dataverse        # concrete mapping for [*] blocks via maps_to
  updated: YYYY-MM-DD

# ─────────────────────────────────────────────────────────────────────────────
# COMPONENTS — one block per solution component. Tags: DE DF DR SL CL API SF BP UC CFG IB
# ─────────────────────────────────────────────────────────────────────────────

# [DE] example_entity
#   intent: <one line — why this entity exists>
#   fields:                 # only logic-driving fields (use [DF]); NOT a full schema
#     - [DF] status         # drives the status gate
#   depends_on: []
#   depended_on_by: []

# [SL] example_service
#   intent: <one line — the business rule this enforces>
#   depends_on:
#     - example_entity       # (mirror: add example_service to example_entity.depended_on_by)
#   depended_on_by: []

