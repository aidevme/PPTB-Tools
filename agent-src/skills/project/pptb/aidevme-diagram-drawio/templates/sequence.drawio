  <diagram id="seq" name="Sequence">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="HSO Sample Sequence — Plugin Execution Pipeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00395F;strokeColor=#00395F;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Segoe UI;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="680" height="36" as="geometry" />
        </mxCell>

        <!-- Lifelines (each is its own participant; x-positions fixed and spaced) -->
        <mxCell id="ll_user" value="User&#10;(Model-driven App)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00395F;fontColor=#00395F;fontSize=12;fontStyle=1;fontFamily=Segoe UI;size=40;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="200" height="680" as="geometry" />
        </mxCell>
        <mxCell id="ll_platform" value="Dataverse&#10;Platform" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00395F;fontColor=#00395F;fontSize=12;fontStyle=1;fontFamily=Segoe UI;size=40;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="200" height="680" as="geometry" />
        </mxCell>
        <mxCell id="ll_pre" value="Pre-Operation&#10;Plugin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00395F;fontColor=#00395F;fontSize=12;fontStyle=1;fontFamily=Segoe UI;size=40;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="200" height="680" as="geometry" />
        </mxCell>
        <mxCell id="ll_db" value="Dataverse&#10;(SQL)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00395F;fontColor=#00395F;fontSize=12;fontStyle=1;fontFamily=Segoe UI;size=40;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="200" height="680" as="geometry" />
        </mxCell>
        <mxCell id="ll_post" value="Post-Operation&#10;Plugin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00395F;fontColor=#00395F;fontSize=12;fontStyle=1;fontFamily=Segoe UI;size=40;" vertex="1" parent="1">
          <mxGeometry x="1400" y="120" width="200" height="680" as="geometry" />
        </mxCell>

        <!--
          Messages: straight horizontal arrows between lifelines at fixed y-coordinates.
          Each message is drawn with absolute geometry (source/target points) so that
          the arrow stays perfectly horizontal regardless of lifeline activation bars.
          y-spacing = 60px between messages.
        -->

        <!-- 1. User -> Platform: Create Account (y=200) -->
        <mxCell id="m1" value="1. Create Account" style="html=1;strokeColor=#00395F;fontColor=#00395F;fontFamily=Segoe UI;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="220" as="sourcePoint" />
            <mxPoint x="540" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. Platform -> Pre Plugin (y=280) -->
        <mxCell id="m2" value="2. Invoke PreOperation" style="html=1;strokeColor=#00395F;fontColor=#00395F;fontFamily=Segoe UI;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="300" as="sourcePoint" />
            <mxPoint x="860" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. Pre Plugin -> Platform: return (validated/modified target) (y=360) -->
        <mxCell id="m3" value="3. Validated Target" style="html=1;strokeColor=#7F9CAF;fontColor=#505050;fontFamily=Segoe UI;fontSize=11;dashed=1;endArrow=open;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="380" as="sourcePoint" />
            <mxPoint x="540" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. Platform -> DB: INSERT (y=440) -->
        <mxCell id="m4" value="4. INSERT row" style="html=1;strokeColor=#00395F;fontColor=#00395F;fontFamily=Segoe UI;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="460" as="sourcePoint" />
            <mxPoint x="1180" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. DB -> Platform: rowid (y=520) -->
        <mxCell id="m5" value="5. row id" style="html=1;strokeColor=#7F9CAF;fontColor=#505050;fontFamily=Segoe UI;fontSize=11;dashed=1;endArrow=open;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180" y="540" as="sourcePoint" />
            <mxPoint x="540" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 6. Platform -> Post Plugin (y=600) -->
        <mxCell id="m6" value="6. Invoke PostOperation (async)" style="html=1;strokeColor=#00395F;fontColor=#00395F;fontFamily=Segoe UI;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="620" as="sourcePoint" />
            <mxPoint x="1500" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 7. Platform -> User: return success (y=680) -->
        <mxCell id="m7" value="7. 201 Created" style="html=1;strokeColor=#00B294;fontColor=#00B294;fontFamily=Segoe UI;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="700" as="sourcePoint" />
            <mxPoint x="220" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Note / callout -->
        <mxCell id="note_async" value="Post-op plugin runs&#10;in a separate transaction&#10;(async queue)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F2B949;strokeColor=#F2B949;fontColor=#00395F;fontSize=10;fontFamily=Segoe UI;size=14;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="540" width="180" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
