<#
.SYNOPSIS
Exports the __DATASET__ records from a seeded environment back to the dataset CSVs.

.DESCRIPTION
The reverse of Import. For each table in the manifest it queries the records whose
primary key appears in the table's `Ids` array, then writes them to the numbered CSV
using the manifest's `Select` column order. Output is DETERMINISTIC (stable column
order from `Select`, rows sorted by primary key) so a re-export produces a byte-identical
file and `git diff` stays reviewable.

Use it to (1) capture records a developer hand-built in Dev, (2) refresh a curated demo,
or (3) detect drift between the live environment and the version-controlled CSVs.

.PARAMETER EnvironmentUrl   Source environment to read from.
.PARAMETER WhatIf           Report row counts without writing the CSVs.

.EXAMPLE
.\Export-__DATASET__.ps1 -EnvironmentUrl https://yourorg.crm.dynamics.com/ -Interactive

.NOTES
Authority SOP: shared/dv/agent/wiki/sop/sample-data/sample-data-validation-workflow.md
Scaffolded by the hso-dataverse-sample-data skill. Do not add client data to this file.
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)][string]$EnvironmentUrl,
    [switch]$Interactive,
    [string]$AccessToken,
    [string]$ClientId,
    [string]$ClientSecret,
    [switch]$WhatIf,
    [string]$AuthSettingsPath = (Join-Path $PSScriptRoot '..\..\..\.claude\auth-settings.json')
)

$ErrorActionPreference = 'Stop'
$_saved = @{ E = $EnvironmentUrl; A = $AccessToken; I = $Interactive; C = $ClientId; S = $ClientSecret; P = $AuthSettingsPath; W = $WhatIf }
$commonFunctions = Join-Path $PSScriptRoot '..\..\..\.scripts\Common-Functions.ps1'
if (-not (Test-Path $commonFunctions)) { throw "Common-Functions.ps1 not found at $commonFunctions. Run hso-dataverse-init-repo to provision it." }
. $commonFunctions
$EnvironmentUrl = $_saved.E; $AccessToken = $_saved.A; $Interactive = $_saved.I; $ClientId = $_saved.C; $ClientSecret = $_saved.S; $AuthSettingsPath = $_saved.P; $WhatIf = $_saved.W

$normalizedEnvUrl = $EnvironmentUrl.TrimEnd('/')
$script:EnvironmentUrl = $normalizedEnvUrl
if ($AccessToken) { $script:AuthToken = $AccessToken; $script:TokenExpiry = (Get-Date).AddHours(1) }
elseif ($Interactive) { $script:AuthToken = Get-DataverseTokenInteractive -EnvironmentUrl $normalizedEnvUrl }
else {
    if ((-not $ClientId -or -not $ClientSecret) -and (Test-Path $AuthSettingsPath)) {
        $a = Get-Content $AuthSettingsPath -Raw | ConvertFrom-Json
        $ClientId = $a.DataverseClientId; $ClientSecret = $a.DataverseClientSecret; $tenantId = $a.DataverseTenantId
    }
    if ($tenantId) {
        $resp = Invoke-RestMethod -Uri "https://login.microsoftonline.com/$tenantId/oauth2/token" -Method Post -ContentType 'application/x-www-form-urlencoded' -Body @{ grant_type = 'client_credentials'; client_id = $ClientId; client_secret = $ClientSecret; resource = $normalizedEnvUrl }
        $script:AuthToken = $resp.access_token
    } else { $script:AuthToken = Get-DataverseToken -EnvironmentUrl $normalizedEnvUrl -ClientId $ClientId -ClientSecret $ClientSecret }
}
if (-not $script:AuthToken) { Write-Error "Authentication failed."; exit 1 }
$script:EnvironmentUrl = $normalizedEnvUrl

function DvHeaders { @{ Authorization = "Bearer $($script:AuthToken)"; 'OData-MaxVersion' = '4.0'; 'OData-Version' = '4.0'; Accept = 'application/json' } }
function DvGet([string]$ep) { Invoke-RestMethod -Uri "$($script:EnvironmentUrl)/api/data/v9.2/$ep" -Method Get -Headers (DvHeaders) }

$DatasetPath = $PSScriptRoot
$manifest = Import-PowerShellDataFile (Join-Path $DatasetPath 'manifest.psd1')
Write-Host "`n=== Export $([System.IO.Path]::GetFileName($DatasetPath)) ===" -ForegroundColor Cyan

foreach ($table in $manifest.Tables) {
    $cols = ($table.Select -split ',').ForEach({ $_.Trim() })
    $idList = @($table.Ids)
    if ($idList.Count -eq 0) { Write-Warning "  $($table.TableName): no Ids in manifest - skipped"; continue }

    # Scope the fetch to the records this dataset owns.
    $filter = ($idList | ForEach-Object { "$($table.PrimaryKey) eq $_" }) -join ' or '
    $resp = DvGet "$($table.EntitySet)?`$select=$($table.Select)&`$filter=$filter"
    $records = @($resp.value) | Sort-Object -Property $table.PrimaryKey

    Write-Host "  $($table.TableName): $($records.Count)/$($idList.Count) records" -ForegroundColor $(if ($records.Count -eq $idList.Count) { 'Green' } else { 'Yellow' })
    if ($WhatIf) { continue }

    # Project onto the manifest's Select column order (stable), then write UTF-8.
    $shaped = $records | ForEach-Object {
        $o = [ordered]@{}
        foreach ($c in $cols) { $o[$c] = $_.PSObject.Properties[$c].Value }
        [pscustomobject]$o
    }
    $outPath = Join-Path $DatasetPath $table.FileName
    $shaped | Export-Csv -Path $outPath -NoTypeInformation -Encoding UTF8
}

Write-Host "`n=== Export complete ===" -ForegroundColor Green
