        <!-- Top actors -> top face of system (entryY=0) -->
        <mxCell id="e_field_sys" value="work orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.1;entryY=0;strokeColor=#00395F;fontColor=#00395F;fontFamily=Segoe UI;fontSize=10;endArrow=classic;endFill=1;" edge="1" parent="1" source="actor_field" target="sys_center">
