{
    "name": "dataverse-early-bound-typescript-generator",
    "version": "1.0.0",
    "displayName": "Dataverse Early-Bound TypeScript Generator",
    "description": "Generate early-bound TypeScript types and metadata for Dataverse, compatible with dataverse-ify and the .dataverse-gen.json config used by dataverse-gen.",
    "main": "index.html",
    "author": "AIDEVME Zsolt Zombik",
    "keywords": [
        "powerplatform",
        "dataverse",
        "toolbox",
        "pptb",
        "typescript",
        "early-bound",
        "dataverse-ify",
        "dataverse-gen",
        "react",
        "fluentui"
    ],
    "license": "GPL-2.0",
    "icon": "icon/dataverse-early-bound-typescript-generator-icon.svg",
    "contributors": [
        {
            "name": "Zsolt Zombik"
        }
    ],
    "configurations": {
        "repository": "https://github.com/aidevme/PPTB-Tools",
        "website": "https://aidevme.github.io/PPTB-Tools/pptb-tools/dataverse-early-bound-typescript-generator/getting-started/",
        "readmeUrl": "https://raw.githubusercontent.com/aidevme/PPTB-Tools/main/tools/dataverse-early-bound-typescript-generator/README.md"
    },
    "features": {
        "connections": 1,
        "minAPI": "1.2.7",
        "enabledForPowerPlatformAPI": false
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/aidevme/PPTB-Tools.git",
        "directory": "tools/dataverse-early-bound-typescript-generator"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc && vite build",
        "build-release": "npm run build && npm version patch --no-git-tag-version",
        "dev": "vite",
        "preview": "vite preview",
        "watch": "vite build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint:tsdoc": "eslint src",
        "finalize-package": "npm shrinkwrap",
        "validate": "pptb-validate"
    },
    "dependencies": {
        "@fluentui/react-components": "^9.74.4",
        "@fluentui/react-icons": "^2.0.334",
        "prism-react-renderer": "2.4.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.7",
        "@types/node": "^24.19.2",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/parser": "^8.71.2",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^10.13.0",
        "eslint-plugin-tsdoc": "^0.5.4",
        "jsdom": "^26.1.0",
        "typescript": "^5.6.3",
        "vite": "^7.1.11",
        "vitest": "^5.0.4"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json",
        "THIRD_PARTY_NOTICES.md"
    ]
}
